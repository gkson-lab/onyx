# Copy to .env. Keys live here only: they are never logged or sent to the browser.

# Where Ollama listens (the default is right when Ollama runs on this PC).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Cloud models are off unless this is "on" AND the key below is set.
ONYX_CLOUD=off
MOONSHOT_API_KEY=

# The plan of the local owner account: free, pro or max.
ONYX_PLAN=max

# Where the database file goes, and the server's port.
ONYX_DB=./data/onyx.db
PORT=8787

# Web search for the Researcher. Without a key it uses DuckDuckGo's HTML page, which works but can break.
BRAVE_API_KEY=

# GitHub connector (config/connectors.yaml): a fine-grained personal access token.
GITHUB_MCP_TOKEN=

# ---- Reaching Onyx from your phone (see SETUP_WHATSAPP.md and SETUP_SMS.md) ----
# The public address of this server, from your tunnel (no trailing slash). Twilio's signature check needs it.
PUBLIC_URL=
# Required as soon as the server is reachable from outside this PC: the password for the app.
ONYX_PASSWORD=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# An approved template with one text variable, used when Onyx texts you first outside the 24-hour window.
WHATSAPP_TEMPLATE=onyx_alert

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
